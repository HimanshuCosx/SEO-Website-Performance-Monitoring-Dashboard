# Copy this file to `.env` (never commit `.env`).
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put secrets here (e.g. the Google PageSpeed API key) — that key lives on the Django backend.

# Base URL of the Django REST API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000/api

# true = use the in-browser simulated backend (UI development only; results are NOT real).
# Must be false (or unset) in production.
VITE_USE_MOCK_API=false

# How often (ms) to poll a running test run for progress.
VITE_POLL_INTERVAL_MS=3000
